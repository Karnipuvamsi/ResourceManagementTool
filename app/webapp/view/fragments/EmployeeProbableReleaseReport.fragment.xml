<core:FragmentDefinition   
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:mdc="sap.ui.mdc"
    xmlns:table="sap.ui.mdc.table"
    xmlns:mdct="sap.ui.mdc.table"
    xmlns:mdcvh="sap.ui.mdc.valuehelp"
    xmlns:mdcvc="sap.ui.mdc.valuehelp.content"
    xmlns:layout="sap.f">
    <layout:DynamicPage
        id="employeeProbableReleaseReportDynamicPage"
        fitContent="false"
        preserveHeaderStateOnScroll="false"
        headerExpanded="false"
        toggleHeaderOnTitleClick="true">
        
        <layout:title>
            <layout:DynamicPageTitle>
                <layout:heading>
                    <Title text="Employee Probable Release Report" level="H2" />
                </layout:heading>
            </layout:DynamicPageTitle>
        </layout:title>
        
        <layout:header>
            <layout:DynamicPageHeader pinnable="false">
                <VBox class="sapUiTinyMargin">
                    <mdc:FilterBar
                        id="employeeProbableReleaseReportFilterBar"
                        delegate='{
                            "name": "glassboard/delegate/EmployeeProbableReleaseReportFilterBarDelegate",
                            "payload": {
                                "collectionPath": "EmployeeProbableReleaseReport"
                            }
                        }'
                        search="onFilterSearch"
                        showAdaptFiltersButton="true"
                        showGoButton="true"
                     
                        filterConditions="{filterModel>/EmployeeProbableReleaseReport/conditions}"
                        p13nMode="Item,Value">
                        <!-- Static filter items - Default filters -->
                        <mdc:filterItems>
                            <!-- Employee Name Filter -->
<mdc:FilterField
       id="filterProbableReleaseOHRID"
                                label="OHR ID"
                                conditions="{filterModel>/EmployeeProbableReleaseReport/conditions/ohrId}"
                                propertyKey="ohrId"
                                maxConditions="-1"
                                required="false"
                             
                                width="250px"
                                valueHelp="vhProbableReleaseOHRID"
      >
        <mdc:dependents>
            <mdc:ValueHelp
                id="vhProbableReleaseOHRID"
                delegate="{
                    name: 'glassboard/delegate/SearchValueHelpDelegate',
                    payload: { searchKeys: ['ohrId','employeeName'] }
                }"
            >
                <mdc:dialog>
                    <mdcvh:Dialog id="dlgProbableReleaseOHRID" title="Select OHR ID">
                    <mdcvc:MDCTable keyPath="ohrId" descriptionPath="ohrId">
                            <mdc:Table
                                id="tblProbableReleaseOHRIDVH"
                                autoBindOnInit="true"
                                selectionMode="Multi"
                                 p13nMode="Column,Sort"
                                enableAutoColumnWidth="true"
                                threshold="20"
                                filter="employeeFilterBar"
                                filterConditions="{filterModel>/Employees/conditions}"
                                width="100%"
                                delegate="{
                                    name: 'glassboard/delegate/EmployeeProbableReleaseReportTableDelegate',
                                    payload: { collectionPath: 'EmployeeProbableReleaseReport', searchKeys: ['ohrId','employeeName'] }
                                }"
                            >    <mdc:type>
                                    <table:GridTableType rowCountMode="Auto" />
                                    </mdc:type>
                                <mdc:columns>
                                    <mdct:Column header="OHR ID" propertyKey="ohrId">
                                        <Text text="{ohrId}" />
                                    </mdct:Column>
                                    <mdct:Column header="Employee name" propertyKey="employeeName">
                                        <Text text="{employeeName}" />
                                    </mdct:Column>
                                </mdc:columns>
                            </mdc:Table>
                        </mdcvc:MDCTable>
 
                    </mdcvh:Dialog>
                </mdc:dialog>
            </mdc:ValueHelp>
        </mdc:dependents>
</mdc:FilterField>
                            <!-- Current Project Filter -->
   <mdc:FilterField
       id="filterProbableReleaseCurrentProject"
                                label="Project"
                                conditions="{filterModel>/EmployeeProbableReleaseReport/conditions/currentProject}"
                                propertyKey="currentProject"
                                maxConditions="-1"
                                required="false"
                             
                                width="250px"
                                valueHelp="vhProbableReleaseCurrentProject"
      >
        <mdc:dependents>
            <mdc:ValueHelp
                id="vhProbableReleaseCurrentProject"
                delegate="{
                    name: 'glassboard/delegate/SearchValueHelpDelegate',
                    payload: { searchKeys: ['projectName'] }
                }"
            >
                <mdc:dialog>
                    <mdcvh:Dialog id="dlgProbableReleaseCurrentProject" title="Select OHR ID">
                    <mdcvc:MDCTable keyPath="projectName" descriptionPath="projectName">
                            <mdc:Table
                                id="tblProbableReleaseCurrentProject"
                                autoBindOnInit="true"
                                selectionMode="Multi"
                                 p13nMode="Column,Sort"
                                enableAutoColumnWidth="true"
                                threshold="20"
                                filter="employeeFilterBar"
                                filterConditions="{filterModel>/Employees/conditions}"
                                width="100%"
                                delegate="{
                                    name: 'glassboard/delegate/EmployeeProbableReleaseReportTableDelegate',
                                    payload: { collectionPath: 'EmployeeProbableReleaseReport', searchKeys: ['projectName'] }
                                }"
                            >    <mdc:type>
                                    <table:GridTableType rowCountMode="Auto" />
                                    </mdc:type>
                                <mdc:columns>
                                    <mdct:Column header="Project Name" propertyKey="projectName">
                                        <Text text="{projectName}" />
                                    </mdct:Column>
                                    
                                </mdc:columns>
                            </mdc:Table>
                        </mdcvc:MDCTable>
 
                    </mdcvh:Dialog>
                </mdc:dialog>
            </mdc:ValueHelp>
        </mdc:dependents>
</mdc:FilterField>                      
                            <!-- Days To Release Filter -->
                            <mdc:FilterField
                                id="filterProbableReleaseDaysToRelease"
                                label="Days To Release"
                                conditions="{filterModel>/EmployeeProbableReleaseReport/conditions/daysToRelease}"
                                propertyKey="daysToRelease"
                                maxConditions="-1"
                                required="false"
                                width="200px"
                                delegate='{
                                    "name": "sap/ui/mdc/field/FieldBaseDelegate",
                                    "payload": {}
                                }'
                            />
                        </mdc:filterItems>
                    </mdc:FilterBar>
                </VBox>
            </layout:DynamicPageHeader>
        </layout:header>
        
        <layout:content>
            <VBox class="sapUiSmallMargin">
                <Panel class="sapUiResponsiveMargin" expandable="false">
                    <ScrollContainer height="600px" vertical="true" horizontal="false">
                        <mdc:Table
                            id="EmployeeProbableReleaseReportTable"
                            header="Employee Probable Release Report"
                            class="verticalsTable rowDetailToggleTable"
                            autoBindOnInit="true"
                            busyIndicatorDelay="0"
                            width="100%"
                            p13nMode="Column,Sort,Filter,Group"
                            selectionMode="None"
                            delegate='{
                                "name": "glassboard/delegate/EmployeeProbableReleaseReportTableDelegate",
                                "payload": {
                                    "collectionPath": "EmployeeProbableReleaseReport"
                                }
                            }'
                            showRowCount="true"
                            threshold="20"
                            enableExport="true"
                            enableAutoColumnWidth="false"
                            filter="employeeProbableReleaseReportFilterBar"
                            filterConditions="{filterModel>/EmployeeProbableReleaseReport/conditions}">
                            
                            <mdc:type>
                                <mdct:ResponsiveTableType />
                            </mdc:type>
                            <mdc:actions>
                                <SegmentedButton 
                                    selectedKey="less"
                                    selectionChange="onToggleRowDetail"
                                    tooltip="Toggle Row Details">
                                    <items>
                                        <SegmentedButtonItem key="more" icon="sap-icon://detail-more" tooltip="Show More"/>
                                        <SegmentedButtonItem key="less" icon="sap-icon://detail-less" tooltip="Show Less"/>
                                    </items>
                                </SegmentedButton>
                            </mdc:actions>
                        </mdc:Table>
                    </ScrollContainer>
                </Panel>
            </VBox>
        </layout:content>
    </layout:DynamicPage>
</core:FragmentDefinition>

